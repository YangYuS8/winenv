{
  "name": "winenv-release",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "description": "Documentation and release automation for Winenv",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.10.0" },
  "repository": {
    "type": "git",
    "url": "https://github.com/YangYuS8/winenv.git"
  },
  "scripts": {
    "docs:sync": "node scripts/sync-docs-changelog.mjs",
    "docs:check": "node scripts/check-docs-i18n.mjs",
    "docs:dev": "pnpm docs:sync && cd docs && astro dev",
    "docs:build": "pnpm docs:sync && pnpm docs:check && astro check --root docs && astro build --root docs && node scripts/finalize-docs.mjs && node scripts/check-docs-site.mjs",
    "docs:preview": "cd docs && astro preview",
    "docs:test": "playwright test",
    "test:docs": "node --test scripts/tests/*.test.mjs",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.0",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "semantic-release": "25.0.9",
    "astro": "7.2.10",
    "@astrojs/starlight": "0.42.0",
    "js-yaml": "4.1.1",
    "parse5": "8.0.1",
    "sharp": "0.35.4",
    "typescript": "5.9.3"
  }
}
