{
  "name": "winenv-release",
  "version": "0.0.0-development",
  "private": true,
  "description": "Release automation for Winenv",
  "repository": {
    "type": "git",
    "url": "https://github.com/YangYuS8/winenv.git"
  },
  "scripts": {
    "docs:sync": "node scripts/sync-docs-changelog.mjs",
    "docs:check": "node scripts/check-docs-i18n.mjs",
    "docs:dev": "npm run docs:sync && vitepress dev docs",
    "docs:build": "npm run docs:sync && npm run docs:check && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "semantic-release": "25.0.9",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vite": "6.4.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
